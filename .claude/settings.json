{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(cargo check*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo deny*)",
      "Bash(cargo audit*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree*)",
      "Bash(curl -s http://localhost:8420/*)",
      "Bash(curl -sS http://127.0.0.1:8420/*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(wc -l *)",
      "Bash(find * -name *.rs*)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p convergio-cli -- session register-and-poll --agent-id \"claude-code-${USER}\" --kind claude --output human || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p convergio-cli -- session heartbeat-since-last-turn --agent-id \"claude-code-${USER}\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet -p convergio-cli -- session pre-stop --agent-id \"claude-code-${USER}\" || true"
          }
        ]
      }
    ]
  },
  "lsp": {
    "rust": {
      "command": "rust-analyzer",
      "languages": ["rust"],
      "initializationOptions": {
        "cargo": {
          "allFeatures": true
        },
        "checkOnSave": {
          "command": "clippy"
        }
      }
    }
  }
}
